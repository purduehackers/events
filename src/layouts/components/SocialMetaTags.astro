---
import defaultOGImageRaw from "@/assets/og.png";
import { getImage } from "astro:assets";

interface Props {
  title: string;
  description: string;
  imageUrl?: string | undefined;
}
const { title, description, imageUrl } = Astro.props;

const ogImageOptions = {
  src: defaultOGImageRaw,
  width: 1200,
  height: 630,
  format: "png",
};
const defaultOpenGraphImage = await getImage(ogImageOptions);
const defaultOpenGraphImageUrl = new URL(defaultOpenGraphImage.src, Astro.url);

---

{/* OpenGraph tags (https://ogp.me) */}
<meta property="og:url" content={Astro.url} />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{imageUrl ? (
  <meta property="og:image" content={imageUrl} />
) : (
  <meta property="og:image:url" content={defaultOpenGraphImageUrl} />
  <meta property="og:image:type" content={`image/${ogImageOptions.format}`} />
  <meta property="og:image:width" content={ogImageOptions.width.toString()} />
  <meta property="og:image:height" content={ogImageOptions.height.toString()} />
)}

{/* Twitter tags */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@purduehackers" />
<meta name="twitter:creator" content="@purduehackers" />
<meta name="twitter:url" content={Astro.url} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{imageUrl
  ? <meta name="twitter:image" content={imageUrl} />
  : <meta name="twitter:image" content={defaultOpenGraphImageUrl} />}
