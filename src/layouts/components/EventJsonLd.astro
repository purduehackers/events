---
// schema.org/Event structured data for Google event rich results.
// https://developers.google.com/search/docs/appearance/structured-data/event
import { truncate } from "@/utilities/helpers";

interface Props {
    name: string;
    startDate: string;
    endDate?: string | null;
    locationName?: string | null;
    imageUrl?: string | null;
    description?: string | null;
    url: string;
}

const { name, startDate, endDate, locationName, imageUrl, description, url } =
    Astro.props;

const DESCRIPTION_MAX_CHARS = 500;
const trimmedDescription = description
    ? truncate(description, DESCRIPTION_MAX_CHARS)
    : undefined;

const jsonLd = {
    "@context": "https://schema.org",
    "@type": "Event",
    name,
    startDate,
    ...(endDate ? { endDate } : {}),
    eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
    eventStatus: "https://schema.org/EventScheduled",
    ...(locationName
        ? {
              location: {
                  "@type": "Place",
                  name: locationName,
                  address: "West Lafayette, IN",
              },
          }
        : {}),
    ...(imageUrl ? { image: [imageUrl] } : {}),
    ...(trimmedDescription ? { description: trimmedDescription } : {}),
    organizer: {
        "@type": "Organization",
        name: "Purdue Hackers",
        url: "https://purduehackers.com",
    },
    url,
    isAccessibleForFree: true,
};

// Escaping "</script" keeps event content from terminating the script block
const json = JSON.stringify(jsonLd).replaceAll("</script", "<\\/script");
---

<script is:inline type="application/ld+json" set:html={json} />
