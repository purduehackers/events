---
import Navbar from "../components/Navbar.astro";
import Hero from "@/components/Hero.astro";
import Marquee from "@/components/Marquee.astro";
import SemesterFilter from "@/components/SemesterFilter.tsx";
import CategoryFilter from "@/components/CategoryFilter.tsx";
import ViewModeToggle from "@/components/ViewModeToggle.tsx";
import SearchBar from "@/components/SearchBar";

import { EVENT_CATEGORIES } from "@/types";
import {
  getSemestersNewestFirst,
} from "@/utilities/helpers";

const allSemesters = getSemestersNewestFirst();
const categories = [...EVENT_CATEGORIES];
---

<Navbar />
<Hero />
<Marquee
    class="hidden text-pink-500 bg-amber-300" 
    text="HACK."
/>
<div class="group/marquee-box w-screen overflow-hidden select-none flex flex-col gap-0">
    <Marquee 
        class="group-hover/marquee-box:hidden top-0 text-sm text-white dark:text-white bg-neutral-800 dark:bg-purple-700 py-1" 
        text="HACK"
    />
    <Marquee 
        class="hidden group-hover/marquee-box:flex top-0 text-sm text-black bg-yellow py-1" 
        text="quack"
        reverse
    />
</div>
<div class="z-10 min-h-[50vh] bg-body-light dark:bg-body-dark">
    <div class="sticky-scroll-lock z-60 sticky top-8 py-1 sm:py-2.5 bg-zinc-200 dark:bg-zinc-800 border-b-1 border-zinc-200 dark:border-zinc-600 text-[15px] font-pixel uppercase">
        <div class="m-auto lg:max-w-screen-2xl px-3 sm:px-12 md:px-18 xl:px-20">
            {/* One control strip: every knob that affects the list lives here.
                On phones the labels and view toggle drop so it stays a single
                row (the sticky offsets in SemesterEvents/SkeletonLoader assume
                its height): the search keeps at least 80px and the filter
                triggers truncate before anything wraps. */}
            <div class="w-full flex items-center justify-between gap-2 sm:gap-6">
                <div class="min-w-0 sm:shrink-0 flex items-center gap-1 sm:gap-2">
                    <h4 class="hidden sm:block">Filter:</h4>
                    <SemesterFilter client:load semesters={allSemesters} />
                    <CategoryFilter client:load categories={categories} />
                </div>

                <div class="flex-1 min-w-20 sm:min-w-0 sm:max-w-xl flex items-center gap-2">
                    <h4 class="hidden sm:block">Search:</h4>
                    <SearchBar client:load />
                </div>

                <div class="hidden sm:block">
                    <ViewModeToggle client:load />
                </div>
            </div>
        </div>
    </div>


    <div class="w-full flex justify-center">
        <slot/>
    </div>
</div>