---
interface Props {
    index: number;
    displayUrl: string | undefined;
    displaySrcset?: string | undefined;
    alt: string;
    width?: number;
    height?: number;
    /** The first (above-the-fold) tiles load eagerly for LCP */
    eager?: boolean;
    /** Stagger offset for tiles revealed by "See more photos" */
    revealDelay?: number;
}

const { index, displayUrl, displaySrcset, alt, width, height, eager = false, revealDelay } =
    Astro.props;
---

<div
    class:list={[
        "w-full break-inside-avoid cursor-pointer mb-2 transition-transform duration-150 ease-snappy hover:scale-[1.02]",
        revealDelay !== undefined && "fade-in-up",
    ]}
    style={revealDelay !== undefined ? `animation-delay: ${revealDelay}ms` : undefined}
    data-gallery-index={index}
    role="button"
    tabindex="0"
    aria-label={`View photo ${index + 1}`}
>
    <img
        src={displayUrl}
        srcset={displaySrcset}
        sizes="(min-width: 768px) 200px, 45vw"
        alt={alt}
        width={width}
        height={height}
        loading={eager ? "eager" : "lazy"}
        decoding="async"
        class="rounded-xs w-full h-auto"
    />
</div>
