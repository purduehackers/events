---
import { getOptimizedImageUrl, getOptimizedSrcset } from "@/utilities/helpers";
import GalleryImage from "./GalleryImage.astro";

interface ImageItem {
  id?: string | number;
  url: string;
  alt?: string;
  width?: number;
  height?: number;
}

interface Props {
  images?: Array<ImageItem | string>;
}

const { images = [] } = Astro.props;

const VISIBLE_COUNT = 3;
const TILE_WIDTHS = [400, 800, 1200];
const LIGHTBOX_WIDTHS = [800, 1200, 1600];

const imageItems = images
  .map((img) => (typeof img === "string" ? { url: img, alt: "Event photo" } : img))
  .map((img) => ({
    // CMS IDs keep shared links attached to the photo when the gallery is reordered.
    hash: `#photo-${encodeURIComponent(String(img.id ?? img.url))}`,
    alt: img.alt ?? "Event photo",
    width: img.width,
    height: img.height,
    displayUrl: getOptimizedImageUrl(img.url, TILE_WIDTHS[0]),
    displaySrcset: getOptimizedSrcset(img.url, TILE_WIDTHS),
    lightboxUrl: getOptimizedImageUrl(img.url, 1200),
    lightboxSrcset: getOptimizedSrcset(img.url, LIGHTBOX_WIDTHS),
  }));

const hiddenCount = Math.max(0, imageItems.length - VISIBLE_COUNT);
const lightboxItems = imageItems.map(({ hash, lightboxUrl, lightboxSrcset, alt }) => ({
  hash,
  url: lightboxUrl,
  srcset: lightboxSrcset ?? "",
  alt,
}));
---

<div
    class="flex flex-col gap-y-4 sm:mx-0 items-center w-full"
>
    <div id="gallery-container" class="w-full">
        <div id="image-area" class="columns-2 md:columns-3 gap-2 space-y-2">
            {imageItems.slice(0, VISIBLE_COUNT).map((img, i) => (
                <GalleryImage index={i} eager {...img} />
            ))}
        </div>
        {hiddenCount > 0 && (
            <template id="gallery-hidden-items">
                {imageItems.slice(VISIBLE_COUNT).map((img, i) => (
                    <GalleryImage
                        index={i + VISIBLE_COUNT}
                        revealDelay={Math.min(i * 30, 240)}
                        {...img}
                    />
                ))}
            </template>
        )}
    </div>

    {hiddenCount > 0 && (
        <button
            id="gallery-view-more"
            class="bg-purple-700 dark:bg-yellow mx-auto py-2 px-2 font-pixel uppercase font-bold text-sm text-white dark:text-black p-2 text-center hover:scale-105 transform cursor-pointer"
        >
            See {hiddenCount} more photos
        </button>
    )}
</div>

{/* Native dialog: focus containment, Escape, and focus restore come free */}
<dialog
    id="lightbox"
    aria-label="Photo gallery"
    class="lightbox-dialog fixed inset-0 w-screen h-screen max-w-none max-h-none p-4 bg-transparent"
>
    <svg class="hidden" aria-hidden="true">
        <symbol id="lightbox-chevron" viewBox="0 0 24 24">
            <path
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 19l-7-7 7-7"></path>
        </symbol>
    </svg>

    <button
        id="lightbox-copy-link"
        class="absolute top-4 left-4 max-w-[calc(100%-6rem)] min-h-11 flex items-center gap-2 text-white/80 hover:text-white z-110 px-3 py-2 rounded-sm bg-black/50 hover:bg-white/10 transition-colors cursor-pointer font-pixel text-sm"
        aria-label="Copy link to this photo"
    >
        <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M10 13a5 5 0 0 0 7.1 0l3-3a5 5 0 0 0-7.1-7.1l-1.7 1.7M14 11a5 5 0 0 0-7.1 0l-3 3a5 5 0 0 0 7.1 7.1l1.7-1.7" />
        </svg>
        <span id="lightbox-copy-label" aria-live="polite">Copy link</span>
    </button>

    <button
        id="lightbox-close"
        class="absolute top-4 right-4 text-white/80 hover:text-white z-110 p-2 rounded-full hover:bg-white/10 transition-colors cursor-pointer"
        aria-label="Close lightbox"
    >
        <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-8 w-8"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
        >
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"></path>
        </svg>
    </button>

    <button
        id="lightbox-prev"
        class="absolute left-4 top-1/2 -translate-y-1/2 text-white/80 hover:text-white z-110 p-2 hidden md:block rounded-full hover:bg-white/10 transition-colors cursor-pointer"
        aria-label="Previous image"
    >
        <svg class="h-10 w-10"><use href="#lightbox-chevron" /></svg>
    </button>

    <button
        id="lightbox-next"
        class="absolute right-4 top-1/2 -translate-y-1/2 text-white/80 hover:text-white z-110 p-2 hidden md:block rounded-full hover:bg-white/10 transition-colors cursor-pointer"
        aria-label="Next image"
    >
        <svg class="h-10 w-10 rotate-180"><use href="#lightbox-chevron" /></svg>
    </button>

    <div
        class="relative w-full h-full flex items-center justify-center pointer-events-none"
    >
        <img
            id="lightbox-img"
            src=""
            alt="Event photo"
            class="pointer-events-auto max-h-[90vh] max-w-[90vw] object-contain rounded-xs shadow-2xl select-none"
        />
    </div>

    <!-- Mobile controls at bottom -->
    <div
        class="absolute bottom-8 left-0 right-0 flex justify-center gap-12 md:hidden z-110"
    >
        <button
            id="lightbox-prev-mobile"
            class="text-white/90 bg-white/10 backdrop-blur-sm rounded-full p-3 active:scale-95 transition-transform"
            aria-label="Previous image"
        >
            <svg class="h-6 w-6"><use href="#lightbox-chevron" /></svg>
        </button>
        <button
            id="lightbox-next-mobile"
            class="text-white/90 bg-white/10 backdrop-blur-sm rounded-full p-3 active:scale-95 transition-transform"
            aria-label="Next image"
        >
            <svg class="h-6 w-6 rotate-180"><use href="#lightbox-chevron" /></svg>
        </button>
    </div>
</dialog>

<script is:inline define:vars={{ lightboxItems }}>
    const imageArea = document.getElementById("image-area");
    const viewMoreBtn = document.getElementById("gallery-view-more");
    const hiddenTemplate = document.getElementById("gallery-hidden-items");

    const lightbox = document.getElementById("lightbox");
    const lightboxImg = document.getElementById("lightbox-img");
    const copyLinkBtn = document.getElementById("lightbox-copy-link");
    const copyLinkLabel = document.getElementById("lightbox-copy-label");

    const allImageItems = Array.isArray(lightboxItems) ? lightboxItems : [];
    let currentImageIndex = 0;
    let previousOverflow = "";
    let copyFeedbackTimeout;

    const resetCopyFeedback = () => {
        clearTimeout(copyFeedbackTimeout);
        copyLinkLabel.textContent = "Copy link";
    };

    const indexFromUrl = () => allImageItems.findIndex((item) => item.hash === window.location.hash);

    const photoUrl = (index) => {
        const url = new URL(window.location.href);
        url.hash = allImageItems[index].hash;
        return url;
    };

    const showImage = (index) => {
        if (allImageItems.length === 0) return;
        currentImageIndex = (index + allImageItems.length) % allImageItems.length;
        const item = allImageItems[currentImageIndex];
        if (!item) return;
        resetCopyFeedback();
        lightboxImg.srcset = item.srcset;
        lightboxImg.sizes = "90vw";
        lightboxImg.src = item.url;
        lightboxImg.alt = item.alt ?? "Event photo";
        // Warm just the next image, not both neighbors
        new Image().src = allImageItems[(currentImageIndex + 1) % allImageItems.length].url;
    };

    const syncLightboxFromUrl = () => {
        const index = indexFromUrl();
        if (index < 0) {
            if (lightbox.open) lightbox.close();
            return;
        }
        if (!lightbox.open || index !== currentImageIndex) showImage(index);
        if (!lightbox.open) {
            previousOverflow = document.body.style.overflow;
            lightbox.showModal();
            document.body.style.overflow = "hidden";
        }
    };

    const openLightbox = (index) => {
        if (!allImageItems[index]) return;
        // One history entry per visit to the gallery; browsing photos replaces it.
        window.history.pushState({
            ...window.history.state,
            eventGalleryReturnUrl: window.location.href,
        }, "", photoUrl(index));
        syncLightboxFromUrl();
    };

    const navigateImage = (offset) => {
        if (allImageItems.length === 0) return;
        showImage(currentImageIndex + offset);
        window.history.replaceState(window.history.state, "", photoUrl(currentImageIndex));
    };

    const closeLightbox = () => {
        if (!lightbox.open) return;
        lightbox.close();
        if (indexFromUrl() < 0) return;
        if (window.history.state?.eventGalleryReturnUrl) {
            window.history.back();
        } else {
            // A shared link may be the tab's first entry. Keep its event page open.
            const url = new URL(window.location.href);
            url.hash = "";
            window.history.replaceState(window.history.state, "", url);
        }
    };

    // Fires for the close button, Escape, and backdrop clicks alike
    lightbox.addEventListener("close", () => {
        if (!lightbox.open) {
            document.body.style.overflow = previousOverflow;
            resetCopyFeedback();
        }
    });
    lightbox.addEventListener("cancel", (e) => {
        e.preventDefault();
        closeLightbox();
    });

    // Open lightbox from any grid image (delegated so revealed images work too)
    imageArea.addEventListener("click", (e) => {
        // Preserve native link actions, including Cmd/Ctrl-click and new tabs.
        if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        const wrapper = e.target.closest("[data-gallery-index]");
        if (!wrapper) return;
        e.preventDefault();
        openLightbox(Number(wrapper.dataset.galleryIndex));
    });
    imageArea.addEventListener("keydown", (e) => {
        // Enter already activates the link; retain Space as a gallery shortcut.
        if (e.key !== " ") return;
        const wrapper = e.target.closest("[data-gallery-index]");
        if (!wrapper) return;
        e.preventDefault();
        openLightbox(Number(wrapper.dataset.galleryIndex));
    });

    // Reveal the rest of the gallery (they only enter the DOM — and start
    // loading — on click)
    viewMoreBtn?.addEventListener("click", () => {
        imageArea.appendChild(hiddenTemplate.content);
        viewMoreBtn.style.display = "none";
    });

    copyLinkBtn.addEventListener("click", async () => {
        const url = photoUrl(currentImageIndex).href;
        try {
            await navigator.clipboard.writeText(url);
            if (!lightbox.open || photoUrl(currentImageIndex).href !== url) return;
            copyLinkLabel.textContent = "Link copied!";
        } catch {
            if (!lightbox.open || photoUrl(currentImageIndex).href !== url) return;
            copyLinkLabel.textContent = "Copy the address bar URL";
        }
        clearTimeout(copyFeedbackTimeout);
        copyFeedbackTimeout = setTimeout(resetCopyFeedback, 3000);
    });

    document.getElementById("lightbox-close").addEventListener("click", closeLightbox);
    for (const id of ["lightbox-prev", "lightbox-prev-mobile"]) {
        document.getElementById(id).addEventListener("click", () => navigateImage(-1));
    }
    for (const id of ["lightbox-next", "lightbox-next-mobile"]) {
        document.getElementById(id).addEventListener("click", () => navigateImage(1));
    }

    lightbox.addEventListener("click", (e) => {
        if (e.target === lightbox) closeLightbox();
    });

    lightbox.addEventListener("keydown", (e) => {
        if (e.key === "ArrowRight" || e.key === "ArrowLeft") {
            e.preventDefault();
            navigateImage(e.key === "ArrowRight" ? 1 : -1);
        }
    });

    window.addEventListener("popstate", syncLightboxFromUrl);
    window.addEventListener("hashchange", syncLightboxFromUrl);
    syncLightboxFromUrl();
</script>
