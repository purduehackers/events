---
import { getOptimizedImageUrl, getOptimizedSrcset } from "@/utilities/helpers";
import GalleryImage from "./GalleryImage.astro";

interface ImageItem {
  url: string;
  alt?: string;
  width?: number;
  height?: number;
}

interface Props {
  images?: Array<ImageItem | string>;
}

const { images = [] } = Astro.props;

const VISIBLE_COUNT = 3;
const TILE_WIDTHS = [400, 800, 1200];
const LIGHTBOX_WIDTHS = [800, 1200, 1600];

const imageItems = images
  .map((img) => (typeof img === "string" ? { url: img, alt: "Event photo" } : img))
  .map((img) => ({
    alt: img.alt ?? "Event photo",
    width: img.width,
    height: img.height,
    displayUrl: getOptimizedImageUrl(img.url, TILE_WIDTHS[0]),
    displaySrcset: getOptimizedSrcset(img.url, TILE_WIDTHS),
    lightboxUrl: getOptimizedImageUrl(img.url, 1200),
    lightboxSrcset: getOptimizedSrcset(img.url, LIGHTBOX_WIDTHS),
  }));

const hiddenCount = Math.max(0, imageItems.length - VISIBLE_COUNT);
const lightboxItems = imageItems.map(({ lightboxUrl, lightboxSrcset, alt }) => ({
  url: lightboxUrl,
  srcset: lightboxSrcset ?? "",
  alt,
}));
---

<div
    class="flex flex-col gap-y-4 sm:mx-0 items-center w-full sm:max-w-lg md:max-w-xl"
>
    <div id="gallery-container" class="w-full">
        <div id="image-area" class="columns-2 md:columns-3 gap-2 space-y-2">
            {imageItems.slice(0, VISIBLE_COUNT).map((img, i) => (
                <GalleryImage index={i} eager {...img} />
            ))}
        </div>
        {hiddenCount > 0 && (
            <template id="gallery-hidden-items">
                {imageItems.slice(VISIBLE_COUNT).map((img, i) => (
                    <GalleryImage index={i + VISIBLE_COUNT} {...img} />
                ))}
            </template>
        )}
    </div>

    {hiddenCount > 0 && (
        <button
            id="gallery-view-more"
            class="bg-purple-700 dark:bg-yellow mx-auto py-2 px-2 font-pixel uppercase font-bold text-sm text-white dark:text-black p-2 text-center hover:scale-105 transform cursor-pointer"
        >
            See {hiddenCount} more photos
        </button>
    )}
</div>

{/* Native dialog: focus containment, Escape, and focus restore come free */}
<dialog
    id="lightbox"
    class="fixed inset-0 w-screen h-screen max-w-none max-h-none p-4 bg-transparent backdrop:bg-black/95 items-center justify-center"
>
    <svg class="hidden" aria-hidden="true">
        <symbol id="lightbox-chevron" viewBox="0 0 24 24">
            <path
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 19l-7-7 7-7"></path>
        </symbol>
    </svg>

    <button
        id="lightbox-close"
        class="absolute top-4 right-4 text-white/80 hover:text-white z-110 p-2 rounded-full hover:bg-white/10 transition-colors cursor-pointer"
        aria-label="Close lightbox"
    >
        <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-8 w-8"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
        >
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"></path>
        </svg>
    </button>

    <button
        id="lightbox-prev"
        class="absolute left-4 top-1/2 -translate-y-1/2 text-white/80 hover:text-white z-110 p-2 hidden md:block rounded-full hover:bg-white/10 transition-colors cursor-pointer"
        aria-label="Previous image"
    >
        <svg class="h-10 w-10"><use href="#lightbox-chevron" /></svg>
    </button>

    <button
        id="lightbox-next"
        class="absolute right-4 top-1/2 -translate-y-1/2 text-white/80 hover:text-white z-110 p-2 hidden md:block rounded-full hover:bg-white/10 transition-colors cursor-pointer"
        aria-label="Next image"
    >
        <svg class="h-10 w-10 rotate-180"><use href="#lightbox-chevron" /></svg>
    </button>

    <div
        class="relative w-full h-full flex items-center justify-center pointer-events-none"
    >
        <img
            id="lightbox-img"
            src=""
            alt="Event photo"
            class="pointer-events-auto max-h-[90vh] max-w-[90vw] object-contain rounded-xs shadow-2xl select-none"
        />
    </div>

    <!-- Mobile controls at bottom -->
    <div
        class="absolute bottom-8 left-0 right-0 flex justify-center gap-12 md:hidden z-110"
    >
        <button
            id="lightbox-prev-mobile"
            class="text-white/90 bg-white/10 backdrop-blur-sm rounded-full p-3 active:scale-95 transition-transform"
            aria-label="Previous image"
        >
            <svg class="h-6 w-6"><use href="#lightbox-chevron" /></svg>
        </button>
        <button
            id="lightbox-next-mobile"
            class="text-white/90 bg-white/10 backdrop-blur-sm rounded-full p-3 active:scale-95 transition-transform"
            aria-label="Next image"
        >
            <svg class="h-6 w-6 rotate-180"><use href="#lightbox-chevron" /></svg>
        </button>
    </div>
</dialog>

<script is:inline define:vars={{ lightboxItems }}>
    const imageArea = document.getElementById("image-area");
    const viewMoreBtn = document.getElementById("gallery-view-more");
    const hiddenTemplate = document.getElementById("gallery-hidden-items");

    const lightbox = document.getElementById("lightbox");
    const lightboxImg = document.getElementById("lightbox-img");

    const allImageItems = Array.isArray(lightboxItems) ? lightboxItems : [];
    let currentImageIndex = 0;

    const showImage = (index) => {
        currentImageIndex = (index + allImageItems.length) % allImageItems.length;
        const item = allImageItems[currentImageIndex];
        if (!item) return;
        lightboxImg.srcset = item.srcset;
        lightboxImg.sizes = "90vw";
        lightboxImg.src = item.url;
        lightboxImg.alt = item.alt ?? "Event photo";
        // Warm just the next image, not both neighbors
        new Image().src = allImageItems[(currentImageIndex + 1) % allImageItems.length].url;
    };

    const openLightbox = (index) => {
        showImage(index);
        lightbox.showModal();
        document.body.style.overflow = "hidden";
    };

    // Fires for the close button, Escape, and backdrop clicks alike
    lightbox.addEventListener("close", () => {
        document.body.style.overflow = "";
    });

    // Open lightbox from any grid image (delegated so revealed images work too)
    imageArea.addEventListener("click", (e) => {
        const wrapper = e.target.closest("[data-gallery-index]");
        if (wrapper) openLightbox(Number(wrapper.dataset.galleryIndex));
    });

    // Reveal the rest of the gallery (they only enter the DOM — and start
    // loading — on click)
    viewMoreBtn?.addEventListener("click", () => {
        imageArea.appendChild(hiddenTemplate.content);
        viewMoreBtn.style.display = "none";
    });

    document.getElementById("lightbox-close").addEventListener("click", () => lightbox.close());
    for (const id of ["lightbox-prev", "lightbox-prev-mobile"]) {
        document.getElementById(id).addEventListener("click", () => showImage(currentImageIndex - 1));
    }
    for (const id of ["lightbox-next", "lightbox-next-mobile"]) {
        document.getElementById(id).addEventListener("click", () => showImage(currentImageIndex + 1));
    }

    lightbox.addEventListener("click", (e) => {
        if (e.target === lightbox) lightbox.close();
    });

    lightbox.addEventListener("keydown", (e) => {
        if (e.key === "ArrowRight") showImage(currentImageIndex + 1);
        if (e.key === "ArrowLeft") showImage(currentImageIndex - 1);
    });
</script>
