---
import MapPin from "@/assets/map-pin.svg";

interface Props {
    locationName: string;
    locationUrl?: string;
}

const { locationName, locationUrl } = Astro.props;

// Prefer a query extracted from a Google Maps location_url; fall back to the
// venue name itself.
let query = locationName;
if (locationUrl) {
    try {
        const parsed = new URL(locationUrl);
        const isMapsHost =
            /(^|\.)google\.[a-z.]+$/.test(parsed.hostname) ||
            parsed.hostname === "maps.app.goo.gl";
        if (isMapsHost) {
            const q = parsed.searchParams.get("q") ?? parsed.searchParams.get("query");
            if (q) {
                query = q;
            } else {
                const placeMatch = parsed.pathname.match(/\/place\/([^/]+)/);
                if (placeMatch?.[1]) {
                    query = decodeURIComponent(placeMatch[1].replaceAll("+", " "));
                }
            }
        }
    } catch {
        // location_url isn't a valid URL; keep the venue-name query
    }
}

const embedUrl = `https://maps.google.com/maps?q=${encodeURIComponent(query)}&output=embed`;
---

<div
    class="w-full p-4 sm:p-6 bg-zinc-900 dark:bg-(--gray-900) dark:border-1 dark:border-zinc-700 text-white border-2"
    data-map-facade
    data-embed-url={embedUrl}
    data-location-name={locationName}
>
    <p class="text-yellow font-display uppercase text-sm mb-4">--location--</p>
    <div class="flex items-center gap-3 mb-4 font-subtext">
        <MapPin class="w-4 shrink-0" />
        <span class="font-semibold">{locationName}</span>
    </div>

    {/* The embed only enters the DOM (and loads Google's iframe payload) on click */}
    <div data-map-slot class="mb-2">
        <button
            type="button"
            data-map-load
            class="cursor-pointer px-3 py-2 font-pixel uppercase font-bold text-sm bg-purple-700 dark:bg-yellow text-white dark:text-black hover:scale-105 transform"
        >
            [ Load map ]
        </button>
    </div>
    {locationUrl && (
        <a
            href={locationUrl}
            target="_blank"
            rel="noreferrer"
            class="inline-block px-3 py-2 font-pixel uppercase font-bold text-sm border-1 border-white text-white hover:text-yellow hover:border-yellow"
        >
            [ Open in Maps ↗ ]
        </a>
    )}
</div>

<script>
    const facade = document.querySelector<HTMLElement>("[data-map-facade]");
    const loadBtn = facade?.querySelector<HTMLButtonElement>("[data-map-load]");
    const slot = facade?.querySelector<HTMLElement>("[data-map-slot]");

    loadBtn?.addEventListener("click", () => {
        if (!facade || !slot) return;
        const wrapper = document.createElement("div");
        // grayscale keeps the light-themed Google tiles from glowing in dark mode
        wrapper.className = "fade-in w-full border-2 border-white dark:grayscale dark:contrast-125";
        const iframe = document.createElement("iframe");
        iframe.src = facade.dataset.embedUrl ?? "";
        iframe.title = `Map of ${facade.dataset.locationName ?? "the venue"}`;
        iframe.loading = "lazy";
        iframe.referrerPolicy = "no-referrer-when-downgrade";
        iframe.className = "w-full h-64 border-0 block";
        wrapper.appendChild(iframe);
        slot.replaceChildren(wrapper);
    });
</script>
