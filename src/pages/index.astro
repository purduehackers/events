---
export const prerender = false;

import CurrentEvents from "../components/CurrentEvents.tsx";
import PastEvents from "../components/past-events/PastEvents.tsx";
import Layout from "@/layouts/Layout.astro";
import HomeLayout from "@/layouts/HomeLayout.astro";
import ListSidebar from "@/components/ListSidebar.tsx";
import { fetchEventsFromCMS, slimEventsForCards } from "@/utilities/cms";
import { formatEasternClock, setCardSelectParams } from "@/utilities/helpers";

const INITIAL_LIMIT = 30;
const apiUrl = new URL('/api/events', Astro.url).href;

// Server-render the first page of both lists so visitors see content instead
// of skeletons; the islands only refetch when a filter actually changes.
const now = new Date().toISOString();

const upcomingParams = new URLSearchParams({
  sort: "start",
  limit: "30",
  page: "1",
  "where[start][greater_than]": now,
});
const pastParams = new URLSearchParams({
  sort: "-start",
  limit: String(INITIAL_LIMIT),
  page: "1",
  "where[start][less_than]": now,
});
setCardSelectParams(upcomingParams);
setCardSelectParams(pastParams);

const [upcomingData, pastData] = await Promise.all([
  fetchEventsFromCMS(upcomingParams),
  fetchEventsFromCMS(pastParams),
]);

const initialUpcoming = upcomingData
  ? slimEventsForCards(upcomingData.docs)
  : null;
const initialUpcomingHasNextPage = Boolean(upcomingData?.hasNextPage);
const initialPast = pastData
  ? slimEventsForCards(pastData.docs)
  : null;
const initialPastHasNextPage = Boolean(pastData?.hasNextPage);

// Server-rendered so the sidebar clock has text before hydration
const initialClock = formatEasternClock();
---

<Layout>
  <HomeLayout>
    <div class="w-full lg:max-w-screen-2xl pt-6 sm:pt-12 px-3 sm:px-12 md:px-12 lg:px-18 xl:px-20">
      <div class="flex justify-between items-stretch gap-6">
        <div class="grow flex flex-col gap-6">
          <CurrentEvents
            client:load
            apiUrl={apiUrl}
            initialEvents={initialUpcoming}
            initialHasNextPage={initialUpcomingHasNextPage}
          />
          <PastEvents
            client:visible
            limit={INITIAL_LIMIT}
            apiUrl={apiUrl}
            initialEvents={initialPast}
            initialHasNextPage={initialPastHasNextPage}
          />
        </div>

        {/* pt-25 lines the calendar up with the first card row instead of the
            "Upcoming" heading */}
        <div class="z-50 hidden md:block w-fit min-w-74 pt-25 pb-24">
          <ListSidebar
            client:media="(min-width: 768px)"
            apiUrl={apiUrl}
            initialClock={initialClock}
          />
        </div>
      </div>
    </div>
  </HomeLayout>
</Layout>
