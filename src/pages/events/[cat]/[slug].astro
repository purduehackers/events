---
export const prerender = false;

import { format } from "date-fns";
import { getCategorySlug, getEventEnd, getLocalizedEventTimes, getSemesterFromDate, getCategoryColor, getCategoryBadgeClasses, getOptimizedImageUrl } from "@/utilities/helpers";

import Layout from "@/layouts/Layout.astro";
import SlugLayout from "@/layouts/SlugLayout.astro";
import Stat from "@/components/past-events/Stat.astro";
import MapPin from "@/assets/map-pin.svg";
import Gallery from "@/components/past-events/Gallery.astro";
import Description from "@/components/past-events/Description.astro";
import EventMap from "@/components/EventMap.astro";
import RelatedEvents from "@/components/RelatedEvents.astro";
import Rsvp from "@/components/Rsvp";
import SocialMetaTags from "@/layouts/components/SocialMetaTags.astro";
import EventJsonLd from "@/layouts/components/EventJsonLd.astro";

import type { EventType, PayloadResponse } from "@/types";
import { CMS_URL } from "@/utilities/constants";
import type { SerializedEditorState } from '@payloadcms/richtext-lexical/lexical';
import { convertLexicalToHTMLAsync } from '@payloadcms/richtext-lexical/html-async';
import { convertLexicalToPlaintext } from '@payloadcms/richtext-lexical/plaintext';

let { cat, slug } = Astro.params;

// Fetch event dynamically from CMS
if (cat == "workshops") cat = "workshop";
if (cat == "callouts") cat = "callout";
let res = await fetch(`${CMS_URL}/api/events?where[eventType][contains]=${cat?.toLowerCase()}&where[slug][equals]=${slug}`, {
  headers: {
    Authorization: `service-accounts API-Key ${import.meta.env.PAYLOAD_API_KEY}`,
  },
});
const data: PayloadResponse<EventType> = await res.json();
const event = data.docs[0];
if (!event) {
  // No matching event found: render the 404 page with a real 404 status
  // instead of a redirect (redirects get ISR-cached and index as 200s)
  return Astro.rewrite('/404');
}

// Convert rich text once during build
const descriptionHTML = await convertLexicalToHTMLAsync({
  data: event.description as SerializedEditorState,
});
const descriptionPlaintext = convertLexicalToPlaintext({ data: event.description });

const isUpcoming = new Date(event.start) > new Date();
const imageThumbnail = event.images?.[0]?.image?.url;

const {
    localizedStart,
    localizedStartTime,
    localizedEndTime,
} = getLocalizedEventTimes(event);

// Generate calendar links
const eventCategorySlug = getCategorySlug(event.eventType);
const eventPageUrl = new URL(`/events/${eventCategorySlug}/${event.slug}`, Astro.url.origin).toString();
const icsUrl = new URL(`/api/events.ics`, Astro.url.origin);
icsUrl.searchParams.set("slug", event.slug);

// Google's dates param wants compact UTC stamps (YYYYMMDDTHHMMSSZ)
const toCalDate = (d: Date) => d.toISOString().replace(/[-:]/g, "").replace(/\.\d{3}Z$/, "Z");
const eventEnd = getEventEnd(event);

const googleCalendarUrl = new URL("https://calendar.google.com/calendar/render");
googleCalendarUrl.searchParams.set("action", "TEMPLATE");
googleCalendarUrl.searchParams.set("text", event.name);
googleCalendarUrl.searchParams.set("dates", `${toCalDate(new Date(event.start))}/${toCalDate(eventEnd)}`);
googleCalendarUrl.searchParams.set("location", event.location_name || "");
googleCalendarUrl.searchParams.set("details", `${event.name}\n\n${event.location_name ? `Location: ${event.location_name}\n` : ""}${eventPageUrl}`);
googleCalendarUrl.searchParams.set("ctz", "America/Indiana/Indianapolis");

const outlookCalendarUrl = new URL("https://outlook.live.com/calendar/0/action/compose");
outlookCalendarUrl.searchParams.set("rru", "addevent");
outlookCalendarUrl.searchParams.set("subject", event.name);
outlookCalendarUrl.searchParams.set("startdt", new Date(event.start).toISOString());
outlookCalendarUrl.searchParams.set("enddt", eventEnd.toISOString());
if (event.location_name) outlookCalendarUrl.searchParams.set("location", event.location_name);
outlookCalendarUrl.searchParams.set("body", eventPageUrl);
---
<Layout canonicalPath={`/events/${eventCategorySlug}/${event.slug}`}>
  <SocialMetaTags
    slot="social"
    title={`${event.name} - Events - Purdue Hackers`}
    description={`${localizedStartTime} – ${localizedEndTime} ET on ${format(localizedStart, "EEEE, MMMM do, yyyy")}${event.location_name ? ` @ ${event.location_name}` : ""}\n\n${descriptionPlaintext}`}
    imageUrl={imageThumbnail}
  />
  <EventJsonLd slot="social" name={event.name} startDate={event.start} endDate={event.end ?? null} locationName={event.location_name} imageUrl={imageThumbnail} description={descriptionPlaintext} url={eventPageUrl} />
  <SlugLayout>
    <div
      class="w-full h-full min-h-screen overflow-clip flex flex-col md:flex-row items-stretch justify-center border-b-2 bg-card-light dark:bg-zinc-900 md:dark:bg-black bg-grid [--grid-size:100px] [--grid-color:rgba(0,0,0,0.5)] dark:[--grid-color:rgba(255,255,255,0.5)]"
    >
      {/* Event header */}
      <div
        class="w-full md:w-1/2 flex-1 bg-card-light dark:bg-zinc-900 md:bg-transparent md:dark:bg-transparent border-black dark:border-white px-5 md:px-10 lg:pl-18 lg:pr-0 pt-8 md:pt-0 pb-6 md:pb-0 text-center border-b-2 md:border-b-0"
      >
        <div class="sticky top-6 mt-6 md:h-screen flex flex-col items-start justify-center">
          <div class="w-full px-4 md:p-10 bg-transparent md:bg-card-light md:dark:bg-black border-none md:border-solid border-2 dark:border-1 border-black dark:border-white flex flex-col-reverse md:flex-col gap-6 2xl:gap-8 items-start justify-center">
            <div class="flex gap-2">
              <div
                class={`min-w-fit rounded-xs px-1 text-white dark:text-black bg-black dark:bg-white border-none dark:border-solid dark:border-white border-1 uppercase text-[12px] font-pixel`}
              >
                {getSemesterFromDate(new Date(event.start)).season} {getSemesterFromDate(new Date(event.start)).year}
              </div>
              {event.eventType && (
                <div
                  class={`min-w-fit rounded-xs px-1 border-none dark:border-solid border-[1px] uppercase text-[12px] font-pixel flex items-center justify-center ${getCategoryBadgeClasses(getCategoryColor(event.eventType))}`}
                >
                  {event.eventType.replaceAll(" ", "-")}
                </div>
              )}
            </div>

            {imageThumbnail && (
              <img
                src={getOptimizedImageUrl(imageThumbnail, 368)}
                alt={`${event.name} thumbnail`}
                width={184}
                height={184}
                decoding="async"
                class="hidden md:block w-32 2xl:w-46 h-32 2xl:h-46 rounded-lg object-cover"
              />
            )}
            <div class="flex flex-col gap-2 md:gap-4 2xl:gap-6">
              <h1 class="text-black dark:text-white font-pixel uppercase text-left text-balance text-4xl md:text-[2.75rem] lg:text-5xl 2xl:text-7xl font-normal">
                {event.name}
              </h1>
              <div class="text-base md:text-lg 2xl:text-2xl font-subtext font-normal">
                <div class="flex flex-col gap-1 md:gap-2 2xl:gap-4 items-start justify-center">
                  <a class="group/date text-black dark:text-gray-200 hover:text-purple-700 dark:hover:text-yellow"
                    href={icsUrl.toString()}
                    target="_blank"
                    rel="noreferrer"
                    download={`${event.slug}.ics`}
                  >
                    <div class="flex gap-4 items-center justify-center">
                      {/* Calendar icon */}
                      <div class="w-8 md:w-10 2xl:w-12 h-8 md:h-10 2xl:h-12 border-2 border-black dark:border-white group-hover/date:border-purple-700 dark:group-hover/date:border-yellow font-pixel uppercase text-black dark:text-white group-hover/date:bg-purple-700 dark:group-hover/date:bg-yellow flex flex-col items-center justify-center">
                        <div class="w-full py-0.5 text-[0.6rem] 2xl:text-sm leading-none bg-black dark:bg-white group-hover/date:bg-white dark:group-hover/date:bg-zinc-900 text-white dark:text-black group-hover/date:text-purple-700 dark:group-hover/date:text-yellow">
                          {format(localizedStart, "MMM")}
                        </div>
                        <div class="grow text-base md:text-xl 2xl:text-2xl leading-none flex items-center justify-center text-black dark:text-white group-hover/date:text-white dark:group-hover/date:text-black">
                          {format(localizedStart, "d")}
                        </div>
                      </div>
                      {/* Full date time */}
                      <div class="flex flex-col gap-1 items-start justify-center">
                        <div class="font-semibold min-w-fit text-left leading-none flex items-center gap-3">
                          {format(localizedStart, "EEEE, MMMM do, yyyy")}
                          <div class="w-3 h-3 bg-black dark:bg-white group-hover/date:bg-purple-700 dark:group-hover/date:bg-yellow text-white dark:text-black leading-none flex items-center justify-center text-sm">+</div>
                        </div>
                        <div
                          class="text-base 2xl:text-lg leading-none"
                          data-event-times
                          data-start-iso={event.start}
                          data-end-iso={event.end ?? ""}
                        >
                          {localizedStartTime} – {localizedEndTime} ET
                        </div>
                      </div>
                    </div>
                  </a>
                  {
                    event.location_name && (
                      <div class={`${event.location_name && "group/loc cursor-pointer hover:text-purple-700 dark:hover:text-yellow"} flex gap-4 items-center justify-center font-bold dark:text-gray-200`}>
                        <div class="w-8 md:w-10 2xl:w-12 h-8 md:h-10 2xl:h-12 border-2 border-black dark:border-white group-hover/loc:border-purple-700 dark:group-hover/loc:border-yellow font-pixel uppercase flex flex-col items-center justify-center">
                          <MapPin class="w-5 2xl:w-6" />
                        </div>
                        <div>
                          {event.location_url ? (
                            <a
                              href={event.location_url}
                              target="_blank"
                              class="font-semibold"
                            >
                              {event.location_name}
                              <span class="px-0.5 font-pixel">↗</span>
                            </a>
                          ) : (
                            <>{event.location_name}</>
                          )}
                        </div>
                      </div>
                    )
                  }
                  {/* Add to calendar */}
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm 2xl:text-base font-pixel uppercase text-black dark:text-gray-200">
                    <span class="text-[12px] 2xl:text-sm text-gray-500 dark:text-gray-400 normal-case font-subtext font-semibold">Add to calendar:</span>
                    <a
                      href={googleCalendarUrl.toString()}
                      target="_blank"
                      rel="noreferrer"
                      class="transition-colors duration-150 hover:text-purple-700 dark:hover:text-yellow"
                    >[ Google ]</a>
                    <a
                      href={icsUrl.toString()}
                      download={`${event.slug}.ics`}
                      class="transition-colors duration-150 hover:text-purple-700 dark:hover:text-yellow"
                    >[ .ics ]</a>
                    <a
                      href={outlookCalendarUrl.toString()}
                      target="_blank"
                      rel="noreferrer"
                      class="transition-colors duration-150 hover:text-purple-700 dark:hover:text-yellow"
                    >[ Outlook ]</a>
                  </div>
                </div>
              </div>
            </div>

          </div>
        </div>
      </div>

      {/* Event description body */}
      <div class="m-auto w-full md:min-h-screen md:w-1/2 flex-1 flex flex-col items-center justify-center md:mt-10 py-6 md:py-20 px-4 md:px-10 lg:pr-20 mb-auto">
        <div class="flex flex-col md:items-start gap-3 md:gap-5 items-center">
          {/* Upcoming: the ask comes first — facts live in the left panel,
              so the first thing in the content column is the action */}
          {isUpcoming && (
            <Rsvp
              client:load
              eventId={event.id}
              eventName={event.name}
              start={event.start}
              gcalUrl={googleCalendarUrl.toString()}
              icsUrl={`${icsUrl.pathname}${icsUrl.search}`}
              icsName={`${event.slug}.ics`}
            />
          )}

          {/* Past: lead with the numbers — they're the headline of the archive */}
          {!isUpcoming && event.stats && event.stats.length > 0 && (
            <div class="w-full max-h-fit flex flex-row flex-1 items-start justify-center gap-4 md:gap-8 p-6 md:px-8 md:py-4 bg-card-light dark:bg-purple-700 text-black dark:text-white border-2 border-black text-center">
              {event.stats.map((stat) => (
                <Stat data={stat.data} label={stat.label} />
              ))}
            </div>
          )}

          <div class="w-full p-4 sm:p-6 sm:mt-0 bg-zinc-900 dark:bg-(--gray-900) dark:border-1 dark:border-zinc-700 text-white border-2">
            <p class="text-yellow font-display uppercase text-sm mb-4">--details--</p>
            <Description>
              <div set:html={descriptionHTML} />
            </Description>
          </div>

          {/* Where to go matters before the event, not after it */}
          {isUpcoming && event.location_name && (
            <EventMap locationName={event.location_name} locationUrl={event.location_url} />
          )}

          {/* An upcoming event's image is its cover art (the hero at left) —
              the photo gallery is an archive feature for past events */}
          {!isUpcoming && event.images && event.images.length > 0 && (
            <Gallery
              images={event.images.map((img) => ({
                url: img.image.url,
                alt: img.image?.alt ?? event.name,
                width: img.image.width,
                height: img.image.height,
              }))}
            />
          )}

          <RelatedEvents eventType={event.eventType} excludeSlug={event.slug} />
        </div>
      </div>
    </div>
  </SlugLayout>
</Layout>

<script>
  // Viewer-local time hint: only rendered when the viewer's clock differs
  // from Eastern at the event's instant (progressive enhancement — without
  // JS the ET display stands alone).
  const timesEl = document.querySelector<HTMLElement>("[data-event-times]");
  if (timesEl?.dataset.startIso) {
    const start = new Date(timesEl.dataset.startIso);
    const end = timesEl.dataset.endIso ? new Date(timesEl.dataset.endIso) : null;
    const timeOpts: Intl.DateTimeFormatOptions = { hour: "numeric", minute: "2-digit" };
    const localFmt = new Intl.DateTimeFormat("en-US", timeOpts);
    const etFmt = new Intl.DateTimeFormat("en-US", {
      ...timeOpts,
      timeZone: "America/Indiana/Indianapolis",
    });

    if (localFmt.format(start) !== etFmt.format(start)) {
      const tzName =
        new Intl.DateTimeFormat("en-US", { ...timeOpts, timeZoneName: "short" })
          .formatToParts(start)
          .find((part) => part.type === "timeZoneName")?.value ?? "";
      const suffix = `your time${tzName ? ` (${tzName})` : ""}`;
      const hint = document.createElement("div");
      hint.className =
        "ml-12 md:ml-14 2xl:ml-16 text-sm 2xl:text-base leading-none text-left font-subtext text-gray-500 dark:text-gray-400";
      hint.textContent = end
        ? `≈ ${localFmt.format(start)} – ${localFmt.format(end)} ${suffix}`
        : `≈ ${localFmt.format(start)} ${suffix}`;
      const anchor = timesEl.closest("a");
      (anchor ?? timesEl).insertAdjacentElement("afterend", hint);
    }
  }
</script>
